{
  "name": "retail-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build:workspace": "pnpm --filter @retail-management/contracts build && pnpm --filter @retail-management/db build",
    "dev": "pnpm build:workspace && pnpm -r --parallel --filter @retail-management/web --filter @retail-management/api run dev",
    "dev:web": "pnpm --filter @retail-management/web dev",
    "dev:api": "pnpm --filter @retail-management/api dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @retail-management/db generate",
    "db:migrate": "pnpm --filter @retail-management/db migrate",
    "db:seed": "pnpm --filter @retail-management/db seed",
    "railway:build": "pnpm --filter @retail-management/contracts build && pnpm --filter @retail-management/db build && pnpm --filter @retail-management/web build && pnpm --filter @retail-management/api build",
    "railway:start": "pnpm --filter @retail-management/api start"
  },
  "devDependencies": {
    "railway": "^3.12.0"
  }
}
