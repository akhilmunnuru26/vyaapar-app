# --- Local development only ---
# Use a local or docker-compose Postgres. NEVER paste Railway production DATABASE_URL here.

# Web: leave VITE_API_ORIGIN unset in dev (Vite proxies /api). Not required for single-service Railway deploy.
# VITE_API_ORIGIN=

NODE_ENV=development
PORT=3000
# docker-compose maps host 5434 → container 5432 (avoids clashing with other local Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/vyaapar_dev
APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SECRET=replace-with-random-string-at-least-32-characters-long
SESSION_TTL_DAYS=14
LOG_LEVEL=debug

# Seed (manual: pnpm db:seed — not run on deploy)
SEED_OWNER_EMAIL=owner@yuvrajsaree.local
SEED_OWNER_PASSWORD=ChangeMe-Dev-Only-8
# SEED_ALLOW_PRODUCTION=true   # required only with NODE_ENV=production

# --- Production (set in Railway dashboard on vyaapar service, not in git) ---
# NODE_ENV=production
# DATABASE_URL=            # ${{postgres.DATABASE_URL}}
# APP_ORIGIN=                # https://your-generated-domain.up.railway.app
# COOKIE_SECRET=             # openssl rand -base64 32
# LOG_LEVEL=info

# WhatsApp / Meta (optional, future)
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_WABA_ID=
# META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
